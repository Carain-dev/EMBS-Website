# ══════════════════════════════════════════════════════════════
# Copy this file to `.env` in the same folder and fill in real values.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed — it holds
# live database and API credentials.
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of extra frontend origins allowed to call this API.
# Any *.vercel.app and *.netlify.app origin is already allowed automatically,
# as is localhost, so this is only needed for a custom domain.
CLIENT_URL=https://your-site.vercel.app

# ── Database ──────────────────────────────────────────────────
# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/embs?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

# ── Cloudinary (image uploads from the admin panel) ───────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (contact form + newsletter) ─────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-address@gmail.com
# For Gmail this must be an App Password, not your account password.
EMAIL_PASS=your-app-password
