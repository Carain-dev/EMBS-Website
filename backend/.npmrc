# multer-storage-cloudinary@4 still declares a peer dependency of
# cloudinary@^1.21, but v1 carries a high severity arbitrary argument
# injection flaw that sits directly in our image upload path.
#
# The package only calls uploader.upload_stream and uploader.destroy, both
# unchanged in v2, and the upload path was tested end to end against a real
# Cloudinary account on v2: upload, fetch back, delete, confirm removal.
#
# Without this, a clean `npm install` fails with ERESOLVE and the deploy
# never starts.
legacy-peer-deps=true
