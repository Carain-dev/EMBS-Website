<mxfile host="app.diagrams.net"><diagram name="CMS Publishing Workflow" id="embs"><mxGraphModel dx="1123" dy="794" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1123" pageHeight="794" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:20px;color:#1F3A5F&quot;&gt;IEEE EMBS KPRIET WEBSITE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="600" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:13px;color:#5F6B76&quot;&gt;CMS Publishing Workflow &amp;amp; System Architecture&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="600" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:9px&quot;&gt;&lt;font color=&quot;#1F3A5F&quot;&gt;━━▶&lt;/font&gt; Admin write path (login required)&lt;br&gt;&lt;font color=&quot;#4E7D5B&quot;&gt;━━▶&lt;/font&gt; Visitor read path (public)&lt;br&gt;&lt;font color=&quot;#5F6B76&quot;&gt;┈┈▶&lt;/font&gt; Media files (Cloudinary)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="760" y="38" width="320" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;background:#1F3A5F;color:#fff;font-weight:bold;font-size:12px;margin:-4px -8px 6px -10px;padding:7px 10px&quot;&gt;&lt;font color=&quot;#9DB7D5&quot;&gt;1&lt;/font&gt;&amp;nbsp;&amp;nbsp;ADMIN PANEL&lt;/div&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;HTML · CSS · JavaScript&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;PURPOSE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Admin / editor logs in to&lt;br&gt;create, edit and delete&lt;br&gt;website content.&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;MANAGES&lt;/b&gt;&lt;/span&gt;&lt;br&gt;• Events · Achievements&lt;br&gt;• Blogs · Podcast episodes&lt;br&gt;• Gallery · Members&lt;br&gt;• Announcements&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#4E7D5B&quot;&gt;Items saved as Draft or Published&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F3A5F;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="190" height="252" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;background:#1F3A5F;color:#fff;font-weight:bold;font-size:12px;margin:-4px -8px 6px -10px;padding:7px 10px&quot;&gt;&lt;font color=&quot;#9DB7D5&quot;&gt;2&lt;/font&gt;&amp;nbsp;&amp;nbsp;BACKEND API &amp;amp; AUTH&lt;/div&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;Node.js + Express.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;AUTHENTICATION&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;JWT&lt;/b&gt;&lt;br&gt;Roles: admin, editor&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;PURPOSE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;REST API (/api/...) receives&lt;br&gt;requests and runs content&lt;br&gt;operations.&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;• Create / edit / delete: JWT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ role check required&lt;br&gt;• Read (GET) routes: public" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F3A5F;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="324" y="168" width="190" height="252" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;background:#1F3A5F;color:#fff;font-weight:bold;font-size:12px;margin:-4px -8px 6px -10px;padding:7px 10px&quot;&gt;&lt;font color=&quot;#9DB7D5&quot;&gt;3&lt;/font&gt;&amp;nbsp;&amp;nbsp;DATABASE&lt;/div&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;MongoDB Atlas&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;+ Mongoose&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;PURPOSE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Stores website content as&lt;br&gt;documents, one Mongoose&lt;br&gt;model per content type.&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;PUBLISHING STATUS&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#4E7D5B&quot;&gt;published: true / false&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;on events, blogs, podcasts&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;and gallery items&lt;br&gt;• Also stores image URLs" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F3A5F;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="608" y="168" width="190" height="252" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;background:#1F3A5F;color:#fff;font-weight:bold;font-size:12px;margin:-4px -8px 6px -10px;padding:7px 10px&quot;&gt;&lt;font color=&quot;#9DB7D5&quot;&gt;4&lt;/font&gt;&amp;nbsp;&amp;nbsp;PUBLIC WEBSITE&lt;/div&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;HTML · CSS · JavaScript&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;PURPOSE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Fetches content through&lt;br&gt;the API and displays it&lt;br&gt;to website visitors.&lt;br&gt;&lt;span style=&quot;font-size:4px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;BEHAVIOUR&lt;/b&gt;&lt;/span&gt;&lt;br&gt;• No login needed&lt;br&gt;• Draft items stay hidden;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;only published ones show&lt;br&gt;• Images load from&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Cloudinary URLs" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F3A5F;strokeWidth=1.3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="893" y="168" width="190" height="252" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#1F3A5F;strokeWidth=1.5;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230" y="296" as="sourcePoint"/><mxPoint x="324" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;API Request&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="232" y="262" width="90" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;HTTPS + JWT&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="232" y="300" width="90" height="16" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#1F3A5F;strokeWidth=1.5;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="514" y="296" as="sourcePoint"/><mxPoint x="608" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;Database&lt;br&gt;Operation&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="262" width="90" height="30" as="geometry"/></mxCell><mxCell id="c15" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;via Mongoose&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="516" y="300" width="90" height="16" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#4E7D5B;strokeWidth=1.5;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="798" y="296" as="sourcePoint"/><mxPoint x="893" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b style=&quot;color:#4E7D5B&quot;&gt;Saved Content /&lt;br&gt;API Response&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="262" width="91" height="30" as="geometry"/></mxCell><mxCell id="c18" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;sent by backend&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="91" height="16" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#4E7D5B;strokeWidth=1.3;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="988.0" y="167" as="sourcePoint"/><mxPoint x="419.0" y="165" as="targetPoint"/><Array as="points"><mxPoint x="988.0" y="134"/><mxPoint x="419.0" y="134"/></Array></mxGeometry></mxCell><mxCell id="c20" value="&lt;b style=&quot;color:#4E7D5B&quot;&gt;Visitor&#x27;s page requests content:  GET /api/events, /api/blogs, ...   (no login)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="429.0" y="112" width="549" height="16" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;color:#2C4A72&quot;&gt;MEDIA STORAGE&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px;color:#1F3A5F&quot;&gt;Cloudinary&lt;/b&gt;&lt;br&gt;Stores uploaded images and files.&lt;br&gt;The app saves and uses their URLs." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F4F6;strokeColor=#5F6B76;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="598" y="446" width="210" height="76" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#5F6B76;strokeWidth=1.3;fontFamily=Arial;fontSize=9;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="419.0" y="421" as="sourcePoint"/><mxPoint x="595" y="484.0" as="targetPoint"/><Array as="points"><mxPoint x="419.0" y="484.0"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;b style=&quot;color:#2C4A72&quot;&gt;Media Upload / URL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="423.0" y="462.0" width="171.0" height="16" as="geometry"/></mxCell><mxCell id="c24" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;Multer, on create / edit&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="423.0" y="488.0" width="171.0" height="16" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#5F6B76;strokeWidth=1.3;fontFamily=Arial;fontSize=9;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="809" y="484.0" as="sourcePoint"/><mxPoint x="988.0" y="423" as="targetPoint"/><Array as="points"><mxPoint x="988.0" y="484.0"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b style=&quot;color:#2C4A72&quot;&gt;Image URL&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="812" y="462.0" width="172.0" height="16" as="geometry"/></mxCell><mxCell id="c27" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;loaded by the browser&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="812" y="488.0" width="172.0" height="16" as="geometry"/></mxCell><mxCell id="c28" value="&lt;span style=&quot;font-size:8px;color:#5F6B76&quot;&gt;&lt;b&gt;HOSTING&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Frontend (public site + admin): Vercel&lt;br&gt;Backend API: Render" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="464" width="240" height="46" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;color:#1F3A5F;font-size:11px&quot;&gt;EXAMPLE: PUBLISHING A WEBSITE EVENT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="579" width="400" height="18" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;1.&amp;nbsp; Admin enters event details&lt;/b&gt;&lt;br&gt;Fills title, date, venue and&lt;br&gt;thumbnail; chooses Draft or&lt;br&gt;Published." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1.1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="40.0" y="607" width="236" height="80" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#1F3A5F;strokeWidth=1.2;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="276.0" y="647.0" as="sourcePoint"/><mxPoint x="309.0" y="647.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;2.&amp;nbsp; Backend API processes it&lt;/b&gt;&lt;br&gt;POST /api/events: JWT + role&lt;br&gt;checked, thumbnail uploaded&lt;br&gt;to Cloudinary." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1.1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="309.0" y="607" width="236" height="80" as="geometry"/></mxCell><mxCell id="c33" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#1F3A5F;strokeWidth=1.2;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.0" y="647.0" as="sourcePoint"/><mxPoint x="578.0" y="647.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b style=&quot;color:#1F3A5F&quot;&gt;3.&amp;nbsp; Event saved in MongoDB&lt;/b&gt;&lt;br&gt;Event document stored with&lt;br&gt;published: true/false and&lt;br&gt;the image URL." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CC;strokeWidth=1.1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="578.0" y="607" width="236" height="80" as="geometry"/></mxCell><mxCell id="c35" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#1F3A5F;strokeWidth=1.2;fontFamily=Arial;fontSize=9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814.0" y="647.0" as="sourcePoint"/><mxPoint x="847.0" y="647.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="&lt;b style=&quot;color:#4E7D5B&quot;&gt;4.&amp;nbsp; Events page displays it&lt;/b&gt;&lt;br&gt;GET /api/events returns only&lt;br&gt;published events; the page&lt;br&gt;shows them to visitors." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF5EF;strokeColor=#4E7D5B;strokeWidth=1.1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=4;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;" vertex="1" parent="1"><mxGeometry x="847.0" y="607" width="236" height="80" as="geometry"/></mxCell><mxCell id="c37" value="&lt;i style=&quot;font-size:9px;color:#5F6B76&quot;&gt;If saved as a Draft (published: false), the event stays visible only in the admin panel. There is no separate approval stage.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="695" width="1043" height="16" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style=&quot;color:#1F3A5F;font-size:11px&quot;&gt;Admin Panel → Backend API → Database → Public Website&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#2B2F33;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="1043" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>